; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Idle Hero Camp"
config/description="Build a frontier camp, train a ten-class hero roster, and conquer a 120-stage idle campaign."
config/version="1.0.0"
run/main_scene="res://TitleMenu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

SceneTransition="*res://SceneTransition.gd"

[display]

window/size/viewport_width=1100
window/size/viewport_height=620

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
